# The same design and the same properties in all four tasks. The only
# thing that ever changes is `depth' -- and the mode, to ask the
# reachability question alongside the assertion one.
#
#   depth 20   assertions   -> shallow        PASS   (and it is a lie)
#   depth 20   reachability -> shallow_cover  FAIL   (which is the alarm)
#   depth 64   assertions   -> deep           FAIL   (the truth)
#   depth 64   reachability -> deep_cover     PASS

[tasks]
vacuity
shallow
shallow_cover
deep
deep_cover

[options]
vacuity: mode cover
vacuity: depth 24
shallow:        mode bmc
deep:           mode bmc
shallow_cover:  mode cover
deep_cover:     mode cover

shallow:        depth 20
shallow_cover:  depth 20
deep:           depth 64
deep_cover:     depth 64

[engines]
smtbmc z3

[script]
read -formal watchdog.v
read -formal props.v
read -formal formal_top.v
prep -top formal_top

# The vacuity task. Can every assertion you wrote ever RUN?
#
# chformal -coverenable turns each assertion's ENABLE -- the condition it
# sits under -- into a cover statement. An assertion whose enable the
# solver cannot reach never executes, so it cannot fail, so it passes. A
# passing assertion that never ran is indistinguishable from one that
# held, and that is the failure this task exists to make visible.
#
# The hand-written cover statements are removed first, so this task asks
# only about assertions and the `cover' task keeps asking about those.
vacuity: chformal -cover  -remove
vacuity: chformal -assert -coverenable
vacuity: chformal -assert -remove

[files]
watchdog.v
props.v
formal_top.v
