# Four tasks over two switches. The design is the same broken FIFO in all
# four; the only thing that ever changes is whether A3 is in force and
# whether we are asking about assertions or about reachability.
#
#   A3 on   assertions -> hollow        PASS   the bug, hidden
#   A3 on   reachability -> hollow_cover FAIL  the alarm
#   A3 off  assertions -> honest        FAIL   the bug, visible
#   A3 off  reachability -> honest_cover PASS  a healthy model

[tasks]
vacuity
hollow
hollow_cover
honest
honest_cover

[options]
vacuity: mode cover
hollow:        mode bmc
honest:        mode bmc
hollow_cover:  mode cover
honest_cover:  mode cover
depth 20

[engines]
smtbmc z3

[script]
read -formal fifo_ctrl.v
hollow:        read -formal props.v
hollow_cover:  read -formal props.v
honest:        read -formal -DHONEST props.v
vacuity:        read -formal -DHONEST props.v
honest_cover:  read -formal -DHONEST props.v
read -formal formal_top.v
prep -top formal_top

# The vacuity task. Can every assertion you wrote ever RUN?
#
# chformal -coverenable turns each assertion's ENABLE -- the condition it
# sits under -- into a cover statement. An assertion whose enable the
# solver cannot reach never executes, so it cannot fail, so it passes. A
# passing assertion that never ran is indistinguishable from one that
# held, and that is the failure this task exists to make visible.
#
# The hand-written cover statements are removed first, so this task asks
# only about assertions and the `cover' task keeps asking about those.
vacuity: chformal -cover  -remove
vacuity: chformal -assert -coverenable
vacuity: chformal -assert -remove

[files]
fifo_ctrl.v
props.v
formal_top.v
