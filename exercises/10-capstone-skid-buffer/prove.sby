[tasks]
good
bad1
bad2
bad3
prove
cover

[options]
good:  mode bmc
bad1:  mode bmc
bad2:  mode bmc
bad3:  mode bmc
prove: mode prove
cover: mode cover
depth 14

[engines]
smtbmc z3

[script]
good:  read -formal good.v
bad1:  read -formal bad1_drops_beats.v
bad2:  read -formal bad2_duplicates.v
bad3:  read -formal bad3_valid_withdrawn.v
prove: read -formal good.v
cover: read -formal good.v
read -formal props.v
read -formal formal_top.v
prep -top formal_top

[files]
props.v
formal_top.v
dut/good.v
dut/bad1_drops_beats.v
dut/bad2_duplicates.v
dut/bad3_valid_withdrawn.v
