# Five tasks over two switches, so that each pair differs in exactly one
# thing. `vacuous' and `buggy' differ only in the assumption; `cover' and
# `vacuous_cover' differ only in the assumption too. Isolating the
# variable is the point -- otherwise "it passed" has two candidate causes.
#
# Task labels are enumerated one per line rather than negated with `~'.
# sby accepts `~task:' for a single label, and the temptation is to write
# `~vacuous ~vacuous_cover:' for the rest; that parses as a yosys command
# and the whole run dies with "No such command". Enumerating is longer and
# says what it means.

[tasks]
vacuity
buggy
fixed
cover
vacuous
vacuous_cover

[options]
vacuity: mode cover
buggy:          mode bmc
fixed:          mode bmc
vacuous:        mode bmc
cover:          mode cover
vacuous_cover:  mode cover
depth 24

[engines]
smtbmc z3

[script]
# The design: broken except where FIXED is defined.
buggy:          read -formal sat_counter.v
vacuous:        read -formal sat_counter.v
fixed:          read -formal -DFIXED sat_counter.v
vacuity:          read -formal -DFIXED sat_counter.v
cover:          read -formal -DFIXED sat_counter.v
vacuous_cover:  read -formal -DFIXED sat_counter.v

# The properties: honest except where OVERCONSTRAIN is defined.
buggy:          read -formal props.v
fixed:          read -formal props.v
vacuity:          read -formal props.v
cover:          read -formal props.v
vacuous:        read -formal -DOVERCONSTRAIN props.v
vacuous_cover:  read -formal -DOVERCONSTRAIN props.v

read -formal formal_top.v
prep -top formal_top

# The vacuity task. Can every assertion you wrote ever RUN?
#
# chformal -coverenable turns each assertion's ENABLE -- the condition it
# sits under -- into a cover statement. An assertion whose enable the
# solver cannot reach never executes, so it cannot fail, so it passes. A
# passing assertion that never ran is indistinguishable from one that
# held, and that is the failure this task exists to make visible.
#
# The hand-written cover statements are removed first, so this task asks
# only about assertions and the `cover' task keeps asking about those.
vacuity: chformal -cover  -remove
vacuity: chformal -assert -coverenable
vacuity: chformal -assert -remove

[files]
sat_counter.v
props.v
formal_top.v
